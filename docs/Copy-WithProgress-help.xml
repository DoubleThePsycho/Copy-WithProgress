    <command:examples>
      <command:example>
        <maml:title>-------------- Example 1 - Copy a single folder. --------------</maml:title>
        <dev:code>PS C:\&gt; Copy-WithProgress -Source C:\Projects -Destination D:\Backup\Projects -Name Projects

Name     Success TimeSpan
----     ------- --------
Projects    True 00:00:12.3456789</dev:code>
        <dev:remarks>
          <maml:para>This example mirrors C:\Projects to D:\Backup\Projects.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------- Example 2 - Copy without deleting. --------------</maml:title>
        <dev:code>PS C:\&gt; Copy-WithProgress C:\Photos D:\Photos -NoMirror</dev:code>
        <dev:remarks>
          <maml:para>This example copies new and changed files from C:\Photos to D:\Photos, and keeps files that only exist in D:\Photos.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------- Example 3 - Copy multiple folders. --------------</maml:title>
        <dev:code>PS C:\&gt; Copy-WithProgress -Object @(
	@{ Name = "Entry 1";    Source = [Source 1];    Destination = [Destination 1] }
	@{ Name = "Entry 2";    Source = [Source 2];    Destination = [Destination 2] }
	@{ Name = "Entry 3";    Source = [Source 3];    Destination = [Destination 3] }
)</dev:code>
        <dev:remarks>
          <maml:para>This example runs through the list of hashtables, copying them one by one from [Source] to [Destination] while displaying the [Name] in the progress bar.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>Example 4 - Copy multiple folders through the pipeline, with a timeout.</maml:title>
        <dev:code>PS C:\&gt; $Jobs | Copy-WithProgress -TimeOut 600 | Where-Object { -not $_.Success }</dev:code>
        <dev:remarks>
          <maml:para>This example copies every job in $Jobs, gives up on any job still running after 10 minutes, and lists the jobs that failed.</maml:para>
        </dev:remarks>
      </command:example>
    </command:examples>
