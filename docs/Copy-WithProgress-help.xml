    <command:details>
      <command:name>Copy-WithProgress</command:name>
      <command:verb>Copy</command:verb>
      <command:noun>WithProgress</command:noun>
      <maml:description>
        <maml:para>Runs robocopy.exe paired up with a progress bar.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Uses RoboCopy to copy a single or multiple folders, while displaying a dunamic progress bar.</maml:para>
    </maml:description>
