<?xml version="1.0" encoding="utf-8"?>
<helpItems schema="maml" xmlns="http://msh">
  <command:command xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10" xmlns:MSHelp="http://msdn.microsoft.com/mshelp">
    <command:details>
      <command:name>Copy-WithProgress</command:name>
      <command:verb>Copy</command:verb>
      <command:noun>WithProgress</command:noun>
      <maml:description>
        <maml:para>Runs robocopy.exe paired up with a progress bar.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>Uses RoboCopy to copy a single or multiple folders, while displaying a dynamic progress bar.</maml:para>
      <maml:para>Before copying, every job is scanned to count the files and bytes to copy. The main progress bar shows the progress of all jobs, and when copying several folders, a nested progress bar shows the current job.</maml:para>
      <maml:para>By default the folders are mirrored with /MIR: files in the destination that no longer exist in the source are DELETED. Use -NoMirror to copy without deleting anything.</maml:para>
      <maml:para>When done, one object per job is returned, telling if the job succeeded and how long it took.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Copy-WithProgress</maml:name>
        <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="False" position="0" aliases="none">
          <maml:name>Source</maml:name>
          <maml:description>
            <maml:para>For single copy job, input path to source folder.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="true" variableLength="true" globbing="false" pipelineInput="False" position="1" aliases="none">
          <maml:name>Destination</maml:name>
          <maml:description>
            <maml:para>For single copy job, input path to destination folder.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="2" aliases="none">
          <maml:name>Name</maml:name>
          <maml:description>
            <maml:para>For single copy job, name to display in the progress bar and in the returned object.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String</command:parameterValue>
          <dev:type>
            <maml:name>String</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>Single job</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="named" aliases="none">
          <maml:name>NoMirror</maml:name>
          <maml:description>
            <maml:para>Copy with /E instead of /MIR, so files in the destination that do not exist in the source are kept instead of deleted.</maml:para>
          </maml:description>
          <dev:type>
            <maml:name>SwitchParameter</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>False</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="named" aliases="none">
          <maml:name>TimeOut</maml:name>
          <maml:description>
            <maml:para>Set a timeout, in seconds, for how long to attempt a job before giving up and proceeding.</maml:para>
            <maml:para>Some files/folders will not copy if the application is active, this is a bypass. If not specified, RoboCopy will keep on trying to copy the files forever. A job that times out is returned with Success set to $false.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">Int32</command:parameterValue>
          <dev:type>
            <maml:name>Int32</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="named" aliases="none">
          <maml:name>ReportGap</maml:name>
          <maml:description>
            <maml:para>How many milliseconds to wait between each progress bar update.</maml:para>
            <maml:para>Lower values update the progress bar more often, at the cost of more CPU use.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">Int32</command:parameterValue>
          <dev:type>
            <maml:name>Int32</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>200</dev:defaultValue>
        </command:parameter>
      </command:syntaxItem>
