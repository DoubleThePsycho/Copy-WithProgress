    <command:examples>
      <command:example>
        <maml:title>---------------- EXAMPLE 1 - Plain conversion. ----------------</maml:title>
        <dev:code>PS C:\&gt; Convert-BytesToReadable 1125899906842624

1 PiB</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------- EXAMPLE 2 - Pipelined conversion. --------------</maml:title>
        <dev:code>PS C:\&gt; 4000000 | Convert-BytesToReadable

3.81 MiB</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------- EXAMPLE 3 - Conversion with math. --------------</maml:title>
        <dev:code>PS C:\&gt; Convert-BytesToReadable ([System.Math]::Pow(2, 120))

1048576 QiB</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------- EXAMPLE 4 - Include conversion in a sentence. --------</maml:title>
        <dev:code>PS C:\&gt; Write-Host ('Total size: {0}' -f (Convert-BytesToReadable -Value 1125899906842624))

Total size: 1 PiB</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>EXAMPLE 5 - Include conversion in a sentence + aligning number.</maml:title>
        <dev:code>PS C:\&gt; Write-Host "Total size: $(Convert-BytesToReadable -Value 1125899906842624 -Alignment 5)"

Total size:     1 PiB</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------- EXAMPLE 6 - Some examples for you to try out! --------</maml:title>
        <dev:code>Convert-BytesToReadable -Value 4 -Alignment 9
Convert-BytesToReadable -Value 4000 -Alignment 9
Convert-BytesToReadable -Val 4000000 -Ali 9
Convert-BytesToReadable -V 4000000000 -A 9
Convert-BytesToReadable 40000000000000 -Alignment 9
Convert-BytesToReadable 40000000000000000 -Alignment 9
Convert-BytesToReadable 40000000000000000000 9
Convert-BytesToReadable 4000000000000000000000 9
Convert-BytesToReadable -Value 4000000000000000000000000 -Alignment 9
Convert-BytesToReadable -Value 4000000000000000000000000000 -Alignment 9
Convert-BytesToReadable -Value ([Int64]::MaxValue).ToString() -Alignment 9
Convert-BytesToReadable ([Decimal]::MaxValue).ToString() -Alignment 9</dev:code>
        <dev:remarks>
          <maml:para></maml:para>
        </dev:remarks>
      </command:example>
    </command:examples>
